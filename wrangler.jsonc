// Cloudflare Workers config. The site is static: Cloudflare serves the files in static/
// (index.html and data/schedule.json) and no Worker code runs.
// Deploy with:  npx wrangler deploy
{
  "name": "ncsu-room-schedules",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./static"
  },
  "observability": {
    "enabled": false
  },
}
